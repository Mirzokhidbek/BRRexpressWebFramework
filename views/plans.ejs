<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rejalar</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f5f7fb;
            min-height: 100vh;
            font-family: Arial, sans-serif;
        }

        .main-container {
            max-width: 750px;
            margin: 70px auto;
        }

        .header h1 {
            font-weight: 700;
            color: #212529;
        }

        .header p {
            color: #6c757d;
        }

        .todo-card {
            background: white;
            border-radius: 18px;
            padding: 25px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.07);
            border: none;
        }

        .input-group-custom {
            display: flex;
            gap: 12px;
        }

        .plan-input {
            height: 52px;
            border-radius: 12px !important;
            border: 1px solid #dee2e6;
            padding: 0 16px;
            font-size: 16px;
        }

        .plan-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.12);
        }

        .add-btn {
            height: 52px;
            border-radius: 12px;
            padding: 0 22px;
            font-weight: 600;
            white-space: nowrap;
        }

        .delete-all {
            margin-top: 18px;
            width: 100%;
            height: 48px;
            border-radius: 12px;
            font-weight: 600;
        }

        .plans-section {
            margin-top: 30px;
        }

        .plans-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .empty-state {
            background: white;
            border-radius: 15px;
            padding: 35px;
            text-align: center;
            color: #6c757d;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        @media (max-width: 576px) {
            .main-container {
                margin: 35px 15px;
            }

            .input-group-custom {
                flex-direction: column;
            }

            .add-btn {
                width: 100%;
            }

            .todo-card {
                padding: 20px;
            }
        }
    </style>
</head>

<body>

<div class="container main-container">

    <!-- Header -->
    <div class="header text-center mb-4">
        <h1>📋 Rejalarim</h1>
        <p class="lead mb-0">
            Bugungi rejalaringizni yozing va boshqaring
        </p>
    </div>


    <!-- Add plan -->
    <div class="todo-card">

        <form id="create-form" action="/create-item" method="POST">

            <div class="input-group-custom">

                <input
                    id="create-field"
                    name="item"
                    autofocus
                    autocomplete="off"
                    class="form-control plan-input"
                    type="text"
                    placeholder="Yangi rejangizni yozing..."
                    required
                >

                <button
                    type="submit"
                    class="btn btn-primary add-btn"
                >
                    + Reja qo‘shish
                </button>

            </div>

        </form>

    </div>


    <!-- Plans -->
    <div class="plans-section">

        <div class="plans-title">
            Mening rejalarim
        </div>

        <!-- Keyinchalik backenddan rejalar shu yerga chiqadi -->
        <div class="empty-state">

            <div style="font-size: 40px;">
                📝
            </div>

            <h5 class="mt-3">
                Hozircha reja yo‘q
            </h5>

            <p class="mb-0">
                Yuqoridagi input orqali yangi reja qo‘shing.
            </p>

        </div>

    </div>


    <!-- Delete all -->
    <button
        id="clean-all"
        class="btn btn-outline-danger delete-all"
    >
        🗑 Hamma rejalarni o‘chirish
    </button>

</div>

</body>

</html>