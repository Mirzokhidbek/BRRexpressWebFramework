<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecom Dashboard - Animated & Interactive</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #5c56f0;
            --primary-hover: #4f46e5;
            --bg-color: #f7f9fb;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #f1f5f9;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* --- Smooth Fade-in Page Animation --- */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .dashboard-container, .header {
            animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* --- Top Header --- */
        .header {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            padding: 20px 40px;
            color: white;
            box-shadow: 0 10px 25px rgba(99, 102, 241, 0.15);
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .logo {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .search-bar {
            background: rgba(255, 255, 255, 0.15);
            padding: 10px 18px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            width: 320px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .search-bar:focus-within {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
            width: 350px;
        }

        .search-bar input {
            background: transparent;
            border: none;
            outline: none;
            color: white;
            font-size: 14px;
            width: 100%;
        }

        .search-bar input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .icon-btn {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            cursor: pointer;
            transition: transform 0.2s, background 0.2s;
        }

        .icon-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.08);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid white;
            transition: transform 0.2s;
            cursor: pointer;
        }

        .user-avatar:hover {
            transform: scale(1.05);
        }

        .nav-tabs {
            display: flex;
            gap: 25px;
            font-size: 14px;
            font-weight: 500;
        }

        .nav-tabs a {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            padding-bottom: 5px;
            position: relative;
            transition: color 0.2s;
        }

        .nav-tabs a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: white;
            transition: width 0.3s ease;
        }

        .nav-tabs a.active, .nav-tabs a:hover {
            color: white;
        }

        .nav-tabs a.active::after, .nav-tabs a:hover::after {
            width: 100%;
        }

        .nav-tabs span {
            background: rgba(255, 255, 255, 0.2);
            padding: 2px 6px;
            border-radius: 8px;
            font-size: 11px;
            margin-left: 4px;
        }

        /* --- Main Dashboard Grid Layout --- */
        .dashboard-container {
            max-width: 1400px;
            margin: 30px auto;
            padding: 0 40px;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 30px;
        }

        @media (max-width: 1024px) {
            .dashboard-container {
                grid-template-columns: 1fr;
            }
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 20px;
        }

        /* --- Recently Added Cards with Hover Animation & Borders --- */
        .recent-added-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .product-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 24px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .product-card:hover {
            transform: translateY(-8px);
            border-color: #c7d2fe;
            box-shadow: 0 15px 35px rgba(92, 86, 240, 0.1);
        }

        .product-card img {
            width: 140px;
            height: 90px;
            object-fit: contain;
            margin-bottom: 15px;
            transition: transform 0.4s ease;
        }

        .product-card:hover img {
            transform: scale(1.08) rotate(-2deg);
        }

        .card-options {
            position: absolute;
            top: 15px;
            right: 15px;
            background: #f8fafc;
            border: 1px solid var(--border);
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            color: var(--text-muted);
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .card-options:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .product-card h4 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .product-card p {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        .price-tag {
            background: var(--primary);
            color: white;
            padding: 8px 24px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 4px 12px rgba(92, 86, 240, 0.3);
            transition: transform 0.2s, background 0.2s;
        }

        .product-card:hover .price-tag {
            background: var(--primary-hover);
            transform: scale(1.05);
        }

        .add-card-placeholder {
            border: 2px dashed #cbd5e1;
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 220px;
            cursor: pointer;
            background: transparent;
            color: var(--text-muted);
            font-size: 28px;
            transition: all 0.3s ease;
        }

        .add-card-placeholder:hover {
            border-color: var(--primary);
            background: rgba(92, 86, 240, 0.03);
            color: var(--primary);
            transform: translateY(-4px);
        }

        /* --- Recent Sold Table --- */
        .recent-sold-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 25px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        }

        .table-header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .time-filter {
            font-size: 13px;
            color: var(--text-muted);
            background: #f1f5f9;
            padding: 8px 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s;
        }

        .time-filter:hover {
            border-color: var(--primary);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 600;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 15px 0;
            font-size: 14px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            transition: background 0.2s;
        }

        tbody tr {
            transition: transform 0.2s;
        }

        tbody tr:hover td {
            background-color: #fafafa;
        }

        .item-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .item-cell img {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            object-fit: cover;
            border: 1px solid var(--border);
        }

        .buyer-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid var(--border);
        }

        .status-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
            text-align: center;
        }

        .status-processing { background: #e0e7ff; color: #4338ca; }
        .status-shiped { background: #f3e8ff; color: #7e22ce; }
        .status-done { background: #dcfce7; color: #15803d; }

        /* --- Income & Financial Card --- */
        .income-card {
            background: var(--card-bg);
            border-radius: 24px;
            padding: 30px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0,0,0,0.02);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .income-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-box {
            background: #f8fafc;
            padding: 20px;
            border-radius: 18px;
            border: 1px solid var(--border);
            text-align: left;
            transition: transform 0.2s, border-color 0.2s;
        }

        .stat-box:hover {
            transform: translateY(-3px);
            border-color: #cbd5e1;
        }

        .stat-box span {
            font-size: 13px;
            color: var(--text-muted);
            display: block;
            margin-bottom: 5px;
        }

        .stat-box h2 {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
        }

        /* Interactive Graph Box */
        .chart-container {
            height: 180px;
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 18px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            padding: 20px;
            margin-bottom: 20px;
            position: relative;
            overflow: hidden;
        }

        .chart-line {
            position: absolute;
            bottom: 40px;
            left: 0;
            width: 100%;
            height: 90px;
            background: linear-gradient(180deg, rgba(92,86,240,0.15) 0%, rgba(92,86,240,0) 100%);
            clip-path: polygon(0 60%, 20% 30%, 40% 70%, 60% 20%, 80% 50%, 100% 15%, 100% 100%, 0 100%);
            animation: pulseGlow 4s ease-in-out infinite alternate;
        }

        @keyframes pulseGlow {
            0% { opacity: 0.7; transform: scaleY(0.95); }
            100% { opacity: 1; transform: scaleY(1.05); }
        }

        .chart-months {
            display: flex;
            justify-content: space-between;
            width: 100%;
            font-size: 11px;
            color: var(--text-muted);
            z-index: 2;
        }

        .chart-tabs {
            display: flex;
            background: #f1f5f9;
            padding: 4px;
            border-radius: 30px;
            margin-bottom: 25px;
            border: 1px solid var(--border);
        }

        .chart-tab {
            flex: 1;
            padding: 8px;
            border: none;
            background: transparent;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
            border-radius: 24px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .chart-tab.active {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 12px rgba(92, 86, 240, 0.3);
        }

        .action-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .btn-primary, .btn-secondary {
            border: none;
            padding: 14px;
            border-radius: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 15px rgba(92, 86, 240, 0.3);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(92, 86, 240, 0.4);
        }

        .btn-secondary {
            background: #8b5cf6;
            color: white;
            box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
        }

        .btn-secondary:hover {
            background: #7c3aed;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(139, 92, 246, 0.4);
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header class="header">
        <div class="header-top">
            <div class="logo">Ecom</div>
            <div class="search-bar">
                <input type="text" placeholder="Search Products...">
            </div>
            <div class="header-actions">
                <button class="icon-btn" title="Notifications">🔔</button>
                <button class="icon-btn" title="Settings">⚙️</button>
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=60" alt="User" class="user-avatar">
            </div>
        </div>
        <nav class="nav-tabs">
            <a href="#" class="active">Home</a>
            <a href="#">Products ▾</a>
            <a href="#">Listed <span>234</span></a>
            <a href="#">Processed <span>24</span></a>
            <a href="#">Sold <span>134</span></a>
            <a href="#">Ship <span>14</span></a>
        </nav>
    </header>

    <!-- Main Content Layout -->
    <div class="dashboard-container">
        <!-- Left Column -->
        <div class="left-column">
            <h2 class="section-title">Recently Added</h2>
            <div class="recent-added-grid">
                <!-- Product Card 1 -->
                <div class="product-card">
                    <button class="card-options" title="More options">•••</button>
                    <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=400&auto=format&fit=crop&q=60" alt="Yeezy">
                    <h4>Yeezy 700 V3</h4>
                    <p>UK 6-11</p>
                    <div class="price-tag">$150</div>
                </div>

                <!-- Product Card 2 -->
                <div class="product-card">
                    <button class="card-options" title="More options">•••</button>
                    <img src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?w=400&auto=format&fit=crop&q=60" alt="Climacool">
                    <h4>Climacool 2020</h4>
                    <p>UK 6-11</p>
                    <div class="price-tag">$170</div>
                </div>

                <!-- Add Placeholder Card -->
                <div class="add-card-placeholder" title="Add New Product">
                    +
                </div>
            </div>

            <!-- Recent Sold Section -->
            <div class="recent-sold-card">
                <div class="table-header-row">
                    <h2 class="section-title" style="margin-bottom:0;">Recent Sold</h2>
                    <select class="time-filter">
                        <option>Last 7 Days ▾</option>
                        <option>Last 30 Days</option>
                        <option>This Year</option>
                    </select>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Buyer</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="item-cell">
                                    <img src="https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100&auto=format&fit=crop&q=60" alt="item">
                                    <span>Sneakers</span>
                                </div>
                            </td>
                            <td>Shoe</td>
                            <td>11/02/15</td>
                            <td>23:13</td>
                            <td><img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=60" class="buyer-avatar" alt="Buyer"></td>
                            <td><span class="status-badge status-processing">Processing</span></td>
                            <td>•••</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="item-cell">
                                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=100&auto=format&fit=crop&q=60" alt="item">
                                    <span>Headphones</span>
                                </div>
                            </td>
                            <td>Gadgets</td>
                            <td>03/20/15</td>
                            <td>10:31</td>
                            <td><img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=60" class="buyer-avatar" alt="Buyer"></td>
                            <td><span class="status-badge status-shiped">Shiped</span></td>
                            <td>•••</td>
                        </tr>
                        <tr>
                            <td>
                                <div class="item-cell">
                                    <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=100&auto=format&fit=crop&q=60" alt="item">
                                    <span>Camera</span>
                                </div>
                            </td>
                            <td>Sports</td>
                            <td>05/21/12</td>
                            <td>19:36</td>
                            <td><img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=60" class="buyer-avatar" alt="Buyer"></td>
                            <td><span class="status-badge status-done">Done</span></td>
                            <td>•••</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right Column -->
        <div class="right-column">
            <div class="income-card">
                <div>
                    <h2 class="section-title">Income</h2>
                    <div class="income-stats">
                        <div class="stat-box">
                            <span>Balance</span>
                            <h2>$12,000</h2>
                        </div>
                        <div class="stat-box">
                            <span>Transferred</span>
                            <h2>$12,000</h2>
                        </div>
                    </div>

                    <!-- Animated Graph visualization box -->
                    <div class="chart-container">
                        <div class="chart-line"></div>
                        <div class="chart-months">
                            <span>March</span>
                            <span>April</span>
                            <span>May</span>
                            <span>June</span>
                            <span>July</span>
                            <span>August</span>
                        </div>
                    </div>

                    <div class="chart-tabs">
                        <button class="chart-tab">Year</button>
                        <button class="chart-tab active">Month</button>
                        <button class="chart-tab">Week</button>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn-primary">Add Goals</button>
                    <button class="btn-secondary">Edit Goals</button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>